{
  "expo": {
    "name": "house-of-edtech-lms",
    "slug": "house-of-edtech-lms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "houseofedtech",

    "experiments": {
      "typedRoutes": false
    },

    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "package": "com.yellapolaakash.houseofedtech",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],

    "extra": {
      "router": {},
      "eas": {
        "projectId": "9483ecaf-7b11-4510-bd95-fa404f8b856c"
      }
    },

    "owner": "yellapola_akash"
  }
}